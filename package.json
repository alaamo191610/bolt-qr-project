{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "vite --host",
    "dev:5175": "vite --host --port 5175",
    "server": "nodemon --exec \"node --import ./server/instrumentation.js\" server/index.js",
    "start": "npm run migrate:deploy && npm run start:server",
    "start:server": "node --import ./server/instrumentation.js server/index.js",
    "migrate:deploy": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema server/prisma/schema.prisma",
    "render-build": "npm ci --include=dev && npx prisma generate --schema server/prisma/schema.prisma && npm run build",
    "build": "vite build",
    "lint": "eslint .",
    "pretest": "npx prisma generate --schema server/prisma/schema.prisma",
    "test": "NODE_ENV=test node --test tests/*.test.js",
    "test:unit": "NODE_ENV=test node --test tests/*.test.js",
    "pretest:integration": "npx prisma generate --schema server/prisma/schema.prisma",
    "test:integration": "NODE_ENV=test node --test tests/integration/*.test.js",
    "test:frontend": "vitest run",
    "test:frontend:watch": "vitest",
    "test:e2e": "playwright test",
    "pretest:e2e:golden": "npx prisma generate --schema server/prisma/schema.prisma",
    "test:e2e:golden": "playwright test --config=playwright.golden.config.ts",
    "test:e2e:install": "playwright install chromium",
    "test:all": "npm run test:unit && npm run test:frontend && npm run test:e2e",
    "verify:tenant-ownership": "node server/prisma/verification/runTenantOwnershipVerification.js",
    "typecheck": "tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.7",
    "@heroicons/react": "^2.2.0",
    "@hugeicons/react": "^1.0.5",
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^4.3.0",
    "@sentry/node": "^10.70.0",
    "@sentry/react": "^10.70.0",
    "@supabase/supabase-js": "^2.53.0",
    "baseline-browser-mapping": "^2.11.11",
    "bcryptjs": "^3.0.3",
    "caniuse-lite": "^1.0.30001806",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "firebase": "^12.1.0",
    "jsonwebtoken": "^9.0.3",
    "line-clamp": "^1.0.0",
    "lucide-react": "^0.344.0",
    "multer": "^2.1.1",
    "pg": "^8.16.3",
    "qr-code-styling": "^1.9.2",
    "react": "^18.3.1",
    "react-csv": "^2.2.2",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.5.0",
    "react-modal": "^3.16.3",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.1.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.62.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/react-modal": "^3.16.3",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^25.0.1",
    "msw": "^2.15.0",
    "nodemon": "^3.1.11",
    "postcss": "^8.4.35",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "tailwindcss-rtl": "^0.9.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.19",
    "vitest": "^2.1.9"
  }
}
