[Unit]
Description=Bolt QR encrypted off-VPS backup
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service
StartLimitIntervalSec=6h
StartLimitBurst=12

[Service]
Type=oneshot
User=boltqrbackup
Group=boltqrbackup
SupplementaryGroups=boltqruploads
EnvironmentFile=/etc/bolt-qr/bolt-qr-backup.env
LoadCredential=restic-password:/etc/bolt-qr/restic-password
LoadCredential=postgres-passfile:/etc/bolt-qr/postgres-passfile
Environment=RESTIC_PASSWORD_FILE=%d/restic-password
Environment=PGPASSFILE=%d/postgres-passfile
ExecStart=/opt/bolt-qr/current/ops/bin/backup-pilot.sh
Restart=on-failure
RestartSec=15m
TimeoutStartSec=4h
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/bolt-qr/uploads
ReadWritePaths=/var/lib/bolt-qr/backup-state /var/cache/bolt-qr-backup
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
