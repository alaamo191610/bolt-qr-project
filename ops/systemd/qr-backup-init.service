[Unit]
Description=Initialize the QR encrypted off-VPS restic repository once
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=qrbackup
Group=qrbackup
EnvironmentFile=/etc/qr/qr-backup.env
LoadCredential=restic-password:/etc/qr/restic-password
Environment=RESTIC_PASSWORD_FILE=%d/restic-password
ExecStart=/usr/bin/restic init
TimeoutStartSec=15m
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/cache/qr-backup
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
