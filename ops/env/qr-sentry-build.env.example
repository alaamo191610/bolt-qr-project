# Source this root-only file before running deploy-release.sh. Install outside the repository as
# /etc/qr/sentry-build.env with owner root:root and mode 0600.
SENTRY_AUTH_TOKEN=REPLACE_WITH_PROJECT_RELEASE_UPLOAD_TOKEN
SENTRY_ORG=REPLACE_WITH_SENTRY_ORGANIZATION_SLUG
SENTRY_PROJECT=REPLACE_WITH_BROWSER_PROJECT_SLUG

# Browser DSNs are public identifiers, not authentication secrets. Keep server and browser projects
# separate so ownership, alert routing, and event volume can be managed independently.
VITE_SENTRY_DSN=https://REPLACE_PUBLIC_KEY@REPLACE_INGEST_HOST/REPLACE_PROJECT_ID
VITE_SENTRY_ENVIRONMENT=pilot
