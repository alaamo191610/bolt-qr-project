# Install as /etc/qr/qr-backup.env with owner root:qrbackup and mode 0640.
# Repository/database passwords belong in systemd credential files, not in this environment file.

# restic encrypts locally before upload. Examples include:
#   s3:s3.example.net/bucket/qr-pilot
#   sftp:backup@example.net:/srv/backups/qr-pilot
RESTIC_REPOSITORY=s3:s3.example.net/REPLACE_BUCKET/qr-pilot
RESTIC_CACHE_DIR=/var/cache/qr-backup/restic

BACKUP_HOST=REPLACE_WITH_UNIQUE_VPS_NAME
BACKUP_STATE_DIR=/var/lib/qr/backup-state
BACKUP_STAGING_ROOT=/var/cache/qr-backup
UPLOAD_DIR=/var/lib/qr/uploads
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
BACKUP_MAX_AGE_HOURS=18

# A dead-man monitoring URL compatible with /start and /fail suffixes. It must alert if no success
# ping arrives within 18 hours. Keep the URL private because it normally contains a monitor token.
BACKUP_HEALTHCHECK_URL=REPLACE_WITH_PRIVATE_MONITOR_URL

# PostgreSQL connection metadata. The password is read from /etc/qr/postgres-passfile.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=restaurant_db
PGUSER=qr
PGCONNECT_TIMEOUT=15

# Provider-specific non-secret settings may be added here. Put access tokens/keys in a root-owned
# service environment/drop-in readable only by qrbackup, never in the repository or app env.
