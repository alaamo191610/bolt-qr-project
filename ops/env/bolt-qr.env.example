# Install as /etc/bolt-qr/bolt-qr.env with owner root:boltqr and mode 0640.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
TRUST_PROXY_HOPS=1
UPLOAD_DIR=/var/lib/bolt-qr/uploads
SHUTDOWN_TIMEOUT_MS=25000

# Replace every placeholder. Keep this file outside the repository.
DATABASE_URL=postgresql://boltqr:REPLACE_ME@127.0.0.1:5432/restaurant_db?schema=public
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
TOKEN_ISSUER=https://api.example.com
CORS_ORIGINS=https://example.com

# Sentry is implemented in the next M3 point. Leave blank until configured.
SENTRY_DSN=
SENTRY_ENVIRONMENT=pilot

