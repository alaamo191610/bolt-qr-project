# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Runtime database connection (DML only) and separate migration-owner connection.
DATABASE_URL="postgresql://qr_runtime:runtime-password@localhost:5432/restaurant_db?schema=public"
MIGRATION_DATABASE_URL="postgresql://qr_migrate:migration-password@localhost:5432/restaurant_db?schema=public"

# JWT Secret for Auth
JWT_SECRET="your-super-secret-jwt-key-change-me"
# Dedicated 32-byte key encoded as exactly 64 hexadecimal characters.
SUPER_ADMIN_MFA_ENCRYPTION_KEY="a81aba70a39d231f6d33aec5d9b0a8c73ceae8a62eeca482420b91798a62b4fa"

# Local application URLs
VITE_API_URL=http://localhost:3000/api
CORS_ORIGINS=http://localhost:5173,http://localhost:5175
PORT=3000
HOST=0.0.0.0
UPLOAD_DIR=./uploads
RELEASE_VERSION=development
SHUTDOWN_TIMEOUT_MS=25000

# Optional local Sentry error monitoring. Keep server/browser projects separate in production.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_RELEASE_VERSION=development
